<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.ArtworkController">

    <padding>
        <Insets bottom="10.0"
                left="10.0"
                right="10.0"
                top="10.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">

        <TextField fx:id="searchField"
                   promptText="Search artworks..."
                   HBox.hgrow="ALWAYS"/>

        <ComboBox fx:id="statusFilter"
                  promptText="Status"/>

        <ComboBox fx:id="typeFilter"
                  promptText="Type"/>

        <ComboBox fx:id="mediumFilter"
                  promptText="Medium"/>

        <Button text="Search"
                onAction="#handleSearch"/>

        <Button text="Reset"
                onAction="#handleReset"/>

    </HBox>

    <TableView fx:id="artworkTable" VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="150"/>
            <TableColumn fx:id="yearColumn" text="Year" prefWidth="70"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="100"/>
            <TableColumn fx:id="mediumColumn" text="Medium" prefWidth="100"/>
            <TableColumn fx:id="dimensionsColumn" text="Dimensions" prefWidth="110"/>
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="180"/>
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="80"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
            <TableColumn fx:id="artistColumn" text="Artist ID" prefWidth="80"/>
            <TableColumn fx:id="tagsColumn" text="Tags" prefWidth="180"/>
        </columns>

    </TableView>

</VBox>