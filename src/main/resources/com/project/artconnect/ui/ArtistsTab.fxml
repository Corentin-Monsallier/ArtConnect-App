<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.ArtistController">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search artists..." HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="activeFilter" promptText="Active" prefWidth="120" />
        <Button text="Search" onAction="#handleSearch" />
        <Button text="Reset" onAction="#handleReset" />
    </HBox>

    <TableView fx:id="artistTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idArtistColumn" text="Artist ID" prefWidth="80" />
            <TableColumn fx:id="idUserColumn" text="User ID" prefWidth="80" />
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="180" />
            <TableColumn fx:id="cityColumn" text="City" prefWidth="130" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="200" />
            <TableColumn fx:id="yearColumn" text="Birth Year" prefWidth="100" />
            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="130" />
            <TableColumn fx:id="bioColumn" text="Bio" prefWidth="260" />
            <TableColumn fx:id="websiteColumn" text="Website" prefWidth="220" />
            <TableColumn fx:id="activeColumn" text="Active" prefWidth="80" />
            <TableColumn fx:id="socialsColumn" text="Socials" prefWidth="320" />
            <TableColumn fx:id="disciplinesColumn" text="Disciplines" prefWidth="200"/>
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button text="Add Artist" onAction="#handleAdd" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Edit Artist" onAction="#handleEdit" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="Delete Artist" onAction="#handleDelete" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>

</VBox>
