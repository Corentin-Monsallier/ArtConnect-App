<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.WorkshopController">

    <padding>
        <Insets bottom="10.0"
                left="10.0"
                right="10.0"
                top="10.0" />
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   promptText="Search workshops..."
                   HBox.hgrow="ALWAYS" />

        <ComboBox fx:id="levelFilter"
                  promptText="Filter by Level"
                  prefWidth="150" />

        <Button text="Search"
                onAction="#handleSearch" />

        <Button text="Reset"
                onAction="#handleReset" />
    </HBox>

    <TableView fx:id="workshopTable"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="idColumn"
                         text="Workshop ID"
                         prefWidth="100" />

            <TableColumn fx:id="titleColumn"
                         text="Title"
                         prefWidth="180" />

            <TableColumn fx:id="dateColumn"
                         text="Date"
                         prefWidth="170" />

            <TableColumn fx:id="durationColumn"
                         text="Duration"
                         prefWidth="100" />

            <TableColumn fx:id="maxParticipantsColumn"
                         text="Max Participants"
                         prefWidth="130" />

            <TableColumn fx:id="priceColumn"
                         text="Price"
                         prefWidth="90" />

            <TableColumn fx:id="levelColumn"
                         text="Level"
                         prefWidth="120" />

            <TableColumn fx:id="locationColumn"
                         text="Location"
                         prefWidth="160" />

            <TableColumn fx:id="descriptionColumn"
                         text="Description"
                         prefWidth="260" />

            <TableColumn fx:id="artistIdColumn"
                         text="Artist ID"
                         prefWidth="90" />

            <TableColumn fx:id="artistNameColumn"
                         text="Instructor"
                         prefWidth="180" />

            <TableColumn fx:id="artistEmailColumn"
                         text="Instructor Email"
                         prefWidth="220" />

            <TableColumn fx:id="artistCityColumn"
                         text="Instructor City"
                         prefWidth="150" />
        </columns>

    </TableView>

</VBox>