<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.BookingController">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search bookings..." HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="statusFilter" promptText="Payment Status" prefWidth="160"/>
        <Button text="Search" onAction="#handleSearch"/>
        <Button text="Reset" onAction="#handleReset"/>
    </HBox>

    <TableView fx:id="bookingTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="memberColumn" text="Member ID" prefWidth="100"/>
            <TableColumn fx:id="workshopColumn" text="Workshop ID" prefWidth="100"/>
            <TableColumn fx:id="dateColumn" text="Booking Date" prefWidth="160"/>
            <TableColumn fx:id="statusColumn" text="Payment Status" prefWidth="140"/>
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button text="Add Booking" onAction="#handleAdd" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Edit Booking" onAction="#handleEdit" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="Delete Booking" onAction="#handleDelete" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>

</VBox>
