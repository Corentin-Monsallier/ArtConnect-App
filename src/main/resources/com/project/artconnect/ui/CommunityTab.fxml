<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.CommunityController">

    <padding>
        <Insets bottom="10.0"
                left="10.0"
                right="10.0"
                top="10.0" />
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">

        <TextField fx:id="searchField"
                   promptText="Search community members..."
                   HBox.hgrow="ALWAYS" />

        <ComboBox fx:id="membershipFilter"
                  promptText="Membership"
                  prefWidth="160" />

        <Button text="Search"
                onAction="#handleSearch" />

        <Button text="Reset"
                onAction="#handleReset" />

    </HBox>

    <TableView fx:id="communityTable"
               VBox.vgrow="ALWAYS">

        <columns>
            <TableColumn fx:id="memberIdColumn"
                         text="Member ID"
                         prefWidth="90" />

            <TableColumn fx:id="userIdColumn"
                         text="User ID"
                         prefWidth="80" />

            <TableColumn fx:id="nameColumn"
                         text="Name"
                         prefWidth="180" />

            <TableColumn fx:id="emailColumn"
                         text="Email"
                         prefWidth="220" />

            <TableColumn fx:id="birthYearColumn"
                         text="Birth Year"
                         prefWidth="100" />

            <TableColumn fx:id="phoneColumn"
                         text="Phone"
                         prefWidth="140" />

            <TableColumn fx:id="cityColumn"
                         text="City"
                         prefWidth="140" />

            <TableColumn fx:id="membershipColumn"
                         text="Membership"
                         prefWidth="150" />


        </columns>

    </TableView>

</VBox>