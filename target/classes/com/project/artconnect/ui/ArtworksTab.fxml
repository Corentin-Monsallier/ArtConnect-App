<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.project.artconnect.ui.ArtworkController">

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search artworks..." HBox.hgrow="ALWAYS" />
        <ComboBox fx:id="statusFilter" promptText="Status" prefWidth="120" />
        <ComboBox fx:id="typeFilter" promptText="Type" prefWidth="120" />
        <ComboBox fx:id="mediumFilter" promptText="Medium" prefWidth="120" />
        <Button text="Search" onAction="#handleSearch" />
        <Button text="Reset" onAction="#handleReset" />
    </HBox>

    <TableView fx:id="artworkTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="60" />
            <TableColumn fx:id="titleColumn" text="Title" prefWidth="180" />
            <TableColumn fx:id="yearColumn" text="Year" prefWidth="80" />
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="100" />
            <TableColumn fx:id="mediumColumn" text="Medium" prefWidth="100" />
            <TableColumn fx:id="dimensionsColumn" text="Dimensions" prefWidth="120" />
            <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="250" />
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="90" />
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="100" />
            <TableColumn fx:id="artistColumn" text="Artist ID" prefWidth="90" />
            <TableColumn fx:id="tagsColumn" text="Tags" prefWidth="150" />
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button text="Add Artwork" onAction="#handleAdd" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Edit Artwork" onAction="#handleEdit" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
        <Button text="Delete Artwork" onAction="#handleDelete" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
    </HBox>

</VBox>
